{
  "name": "coremetry-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:analyze": "tsc --noEmit && ANALYZE=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:ds": "vite build --config vite.lib.config.ts && tsc -p tsconfig.ds.json && echo \"export * from './types/components/ui/index';\" > dist-ds/index.d.ts"
  },
  "dependencies": {
    "@grafana/data": "13.1.2",
    "@grafana/ui": "13.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-document-load": "^0.68.0",
    "@opentelemetry/instrumentation-fetch": "^0.223.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.67.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-virtual": "^3.13.26",
    "@types/dagre": "^0.7.54",
    "dagre": "^0.8.5",
    "lucide-react": "^1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^6.30.6",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@types/node": "^22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "browserslist": "^4.28.7",
    "nanoid": "^3.3.18",
    "uplot": "1.6.32",
    "moment": "2.31.0",
    "@grafana/ui": { "react": "$react", "react-dom": "$react-dom" },
    "@grafana/data": { "react": "$react", "react-dom": "$react-dom" },
    "react-custom-scrollbars-2": { "react": "$react", "react-dom": "$react-dom" },
    "react-table": { "react": "$react" }
  },
  "types": "dist-ds/index.d.ts"
}
