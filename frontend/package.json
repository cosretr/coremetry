{
  "name": "coremetry-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "bundle:check": "vite build && node scripts/bundle-budget.mjs",
    "design:axe:full": "DESIGN_AXE=all TZ=UTC vitest run src/pages/design/designAxe.test.tsx",
    "build:analyze": "tsc --noEmit && ANALYZE=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:ds": "vite build --config vite.lib.config.ts && tsc -p tsconfig.ds.json && echo \"export * from './types/components/ui/index';\" > dist-ds/index.d.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "2.0.279",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@grafana/data": "13.3.1",
    "@grafana/ui": "13.3.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-zone": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation": "^0.301.1",
    "@opentelemetry/instrumentation-document-load": "^0.70.0",
    "@opentelemetry/instrumentation-fetch": "^0.301.1",
    "@opentelemetry/instrumentation-user-interaction": "^0.69.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/dagre": "^0.7.54",
    "ai": "5.0.276",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^1.72.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/node": "^22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "browserslist": "^4.28.7",
    "nanoid": "^3.3.18",
    "uplot": "1.6.32",
    "moment": "2.31.0",
    "@grafana/ui": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@grafana/data": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-custom-scrollbars-2": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-table": {
      "react": "$react"
    },
    "@ai-sdk/provider-utils": {
      "undici": "6.29.1"
    }
  },
  "types": "dist-ds/index.d.ts"
}
