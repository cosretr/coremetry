{
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go vet ./...)",
      "Bash(go vet *)",
      "Bash(go list *)",
      "Bash(make docker-up)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(gh run watch *)",
      "Bash(helm template *)",
      "Bash(helm lint *)",
      "Bash(helm show *)",
      "Bash(helm pull *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)",
      "Bash(go test *)",
      "Bash(make test)",
      "Bash(make test-race)",
      "Bash(make audit)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl rollout status *)",
      "Bash(kubectl top *)",
      "Bash(minikube status)",
      "Bash(minikube status *)",
      "Bash(minikube dashboard *)",
      "Bash(minikube config get *)",
      "Bash(docker images *)",
      "Bash(docker inspect *)",
      "Bash(docker ps *)",
      "Bash(scripts/gate.sh *)",
      "Bash(bash scripts/gate.sh *)",
      "Bash(scripts/dev-up.sh)",
      "Bash(scripts/dev-seed.sh)",
      "Bash(scripts/dev-seed.sh *)",
      "Bash(scripts/dev-api.sh *)",
      "Bash(scripts/dev-ch.sh *)",
      "Bash(scripts/dev-prom.sh *)",
      "Bash(scripts/dev-shot.sh *)",
      "Bash(scripts/dev/verify-stamp.sh *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(rg *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(docker stats --no-stream)",
      "Bash(docker stats --no-stream *)",
      "Bash(golangci-lint run *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git commit *)",
      "Bash(docker compose up *)",
      "Bash(docker compose * up *)",
      "Bash(helm upgrade *)",
      "Bash(helm install *)",
      "Bash(kubectl apply *)",
      "Bash(scripts/dev-api.sh *--write*)",
      "Bash(scripts/dev-up.sh *--deploy*)",
      "Bash(scripts/dev-deploy.sh*)",
      "Bash(scripts/dev-down.sh*)",
      "Bash(scripts/dev-up.sh --es*)"
    ],
    "deny": [
      "Bash(docker volume *)",
      "Bash(docker system prune *)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose * down -v*)",
      "Bash(kubectl delete *)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify-check.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  }
}
